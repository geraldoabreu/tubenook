{
  "manifest_version": 3,
  "name": "TubeNook — YouTube Subscriptions, Playlists & Courses",
  "short_name": "TubeNook",
  "version": "1.0.0",
  "description": "Organize YouTube subscriptions and playlists with nested folders, Deck view, auto-tagging, unlimited watched tracking, and advanced filters.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "TubeNook",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*",
        "src/shared/*",
        "assets/*"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
